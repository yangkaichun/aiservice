{
  "openapi": "3.1.0",
  "info": {
    "title": "PanCAD.ai Public Site Health API",
    "version": "1.0.0",
    "description": "A public, read-only endpoint for checking the availability of pancad.ai public web services."
  },
  "servers": [{ "url": "https://www.pancad.ai" }],
  "paths": {
    "/api/health.json": {
      "get": {
        "operationId": "getPublicSiteHealth",
        "summary": "Get public site health",
        "responses": {
          "200": {
            "description": "The public site is available.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "service"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" },
                    "service": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
